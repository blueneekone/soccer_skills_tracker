{
  "firestore": {
    "rules": "firestore.rules"
  },
  "apphosting": {
    "backendId": "soccer-skills-tracker",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://static.cloudflareinsights.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com https://api.fontshare.com https://api.fonts.coollabs.io; img-src 'self' data: blob: https:; font-src 'self' data: https: https://fonts.gstatic.com https://api.fontshare.com https://api.fonts.coollabs.io; worker-src 'self' blob:; connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://*.googleapis.com https://sstracker.app https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.cloudfunctions.net https://*.run.app https://web-sdk-services.checkr.com; frame-src 'self' https://accounts.google.com https://www.gstatic.com https://*.google.com https://*.firebaseapp.com; frame-ancestors 'self'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/compliance/checkr/session-tokens",
        "function": {
          "functionId": "checkrSessionTokens"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "source": "functions",
      "runtime": "nodejs22"
    },
    {
      "codebase": "core",
      "source": "functions-core",
      "runtime": "nodejs22",
      "predeploy": ["node scripts/bundle-functions.cjs"]
    },
    {
      "codebase": "rl",
      "source": "functions-rl",
      "runtime": "nodejs22",
      "predeploy": ["node scripts/bundle-functions.cjs"]
    },
    {
      "codebase": "commerce",
      "source": "functions-commerce",
      "runtime": "nodejs22",
      "predeploy": ["node scripts/bundle-functions.cjs"]
    },
    {
      "codebase": "compliance",
      "source": "functions-compliance",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/sync-compliance-env.cjs",
        "node scripts/bundle-functions.cjs"
      ]
    },
    {
      "codebase": "integrations",
      "source": "functions-integrations",
      "runtime": "nodejs22",
      "predeploy": ["node scripts/bundle-functions.cjs"]
    },
    {
      "codebase": "platform",
      "source": "functions-platform",
      "runtime": "nodejs22",
      "predeploy": ["node scripts/bundle-functions.cjs"]
    }
  ]
}
