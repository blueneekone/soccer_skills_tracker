# ── Firebase environment toggle ─────────────────────────────────────────────
# Set to "true" to use production Firebase (soccer-skills-tracker). Default is dev.
VITE_USE_PROD=false

# ── Required Firebase Client API Keys ─────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain

# ── Firebase DEV project config (sports-skill-tracker-dev) ─────────────────
# These are fallback values in firebase.js. Override here for CI isolation.
# VITE_FIREBASE_DEV_API_KEY=
# VITE_FIREBASE_DEV_AUTH_DOMAIN=
# VITE_FIREBASE_DEV_PROJECT_ID=
# VITE_FIREBASE_DEV_STORAGE_BUCKET=
# VITE_FIREBASE_DEV_MESSAGING_SENDER_ID=
# VITE_FIREBASE_DEV_APP_ID=
# VITE_FIREBASE_DEV_MEASUREMENT_ID=

# ── Firebase PROD project config (soccer-skills-tracker) ────────────────────
# Override here to avoid hardcoded fallbacks in source (recommended for prod CI).
# VITE_FIREBASE_PROD_API_KEY=
# VITE_FIREBASE_PROD_AUTH_DOMAIN=
# VITE_FIREBASE_PROD_PROJECT_ID=
# VITE_FIREBASE_PROD_STORAGE_BUCKET=
# VITE_FIREBASE_PROD_MESSAGING_SENDER_ID=
# VITE_FIREBASE_PROD_APP_ID=

# ── Third-party API Service Keys ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=re_xxx
GOOGLE_MAPS_API_KEY=AIzaSy_xxx
CHECKR_API_KEY=checkr_xxx
GEMINI_API_KEY=AIzaSy_gemini_xxx

# Cloud Functions (deploy): create a strong random secret, then:
#   firebase functions:secrets:set WORKOUT_ATTESTATION_HMAC_SECRET
# Required for submitWorkoutRep (HMAC integrity digest on workout logs).
#
#   firebase functions:secrets:set AFFINITY_WEBHOOK_HMAC_SECRET
# Required for affinityWebhook: raw body HMAC-SHA256, header
#   X-SSTRACKER-Signature: sha256=<hex>
#
# Epic 9 — Stripe (Cloud Functions):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# Configure Price IDs (per environment / project), e.g.:
#   firebase functions:config:set stripe.price_tutor="price_..."   # legacy; prefer:
# Use Firebase params in deployment UI or:
#   firebase deploy --only functions -e STRIPE_PRICE_TUTOR=price_xxx ...
# Params: STRIPE_PRICE_TUTOR, STRIPE_PRICE_TEAM, STRIPE_PRICE_CLUB, STRIPE_PRICE_RECRUITER
#
# Epic 13 — FCM web push (client): Firebase Console → Project settings → Cloud Messaging
# → Web Push certificates → Key pair → paste the *public* key here:
#   VITE_FCM_VAPID_KEY=BNxxx...

# Google Maps (Field Ops): Vite reads `.env`, not `.env.example` — put `VITE_GOOGLE_MAPS_*` and Map ID in `.env` (section 2).

# Checkr coach clearance — prefer Firestore `clubs/{clubId}` fields:
#   checkrPackageSlug, checkrWorkState, checkrWorkCity, checkrNode (optional)
# Dev fallback only (Vite / Cloud Functions env):
# VITE_CHECKR_ENV=staging
# VITE_CHECKR_PACKAGE_SLUG=your_club_coach_package_slug
# CHECKR_PACKAGE_SLUG=your_club_coach_package_slug
# VITE_CHECKR_WORK_STATE=CA
# CHECKR_WORK_STATE=CA
# VITE_CHECKR_WORK_CITY=San Francisco
