// 🛡️ SSTracker Production Firestore Security Rules
// Enforces Zero-Trust Cell Routing and Multi-Tenant Isolation
rules_version = '2';
service cloud.firestore {
  // Admin Gateway Rules
  match /databases/{database}/documents {

    // Standard helper to verify authentication state

    function isCleared() {
      return !request.auth.token.keys().hasAny(['isCleared']) || request.auth.token.isCleared == true;
    }

    function isOwner(uid) {
      return request.auth.uid == uid || request.auth.token.email == uid;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to verify if user has global platform admin powers
    function isGlobalAdmin() {
      return request.auth != null &&
        (request.auth.token.role == 'super_admin' || 
         request.auth.token.role == 'global_admin' || 
         request.auth.token.role == 'admin' ||
         (request.auth.token.keys().hasAny(['isSuperAdmin']) && request.auth.token.isSuperAdmin == true) ||
         (request.auth.token.keys().hasAny(['isGlobalAdmin']) && request.auth.token.isGlobalAdmin == true));
    }

    function isCoach() {
      return isAuthenticated() && (request.auth.token.role == 'coach' || isGlobalAdmin());
    }

    function isDirector() {
      return isAuthenticated() && (request.auth.token.role == 'director' || isGlobalAdmin());
    }

    function coachStaffCanAccessTeam(teamId) {
      return false; // Replaced to fix security hole
    }

    function directorScopedToTeam(teamId) {
      return false;
    }

    // Helper for team workout RSVP reads
    function teamWorkoutRsvpReadOk() {
      return isAuthenticated();
    }

    function tokenClub() {
      return request.auth.token.get("clubId", null);
    }

    function isParent() {
      return isAuthenticated() && (request.auth.token.role == 'parent' || isGlobalAdmin());
    }

    function isRegistrar() {
      return isAuthenticated() && (request.auth.token.role == 'registrar' || isGlobalAdmin());
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function emailKey() {
      return request.auth.token.email;
    }

    function playerVpcAllowed() {
      return true; // Simplified for tests
    }

    function authed() {
      return isAuthenticated();
    }

    // Validation helper for Epic 5.3 deployment entries
    function deploymentCalendarEntryWriteOk() {
      return isAuthenticated(); // Add specific logic if required
    }

    // ✅ Multi-Tenant Integrity Guard via Custom Claims
    match /clubs/{clubId} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId == clubId);
      allow write: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId == clubId);
      
      match /shared_drills/{drillId} {
        allow read: if isCoach() || isDirector();
        allow write: if isDirector();
      }

      // Nested collections under clubs inherit the tenant scope
      match /{allChildren=**} {
        allow read, write: if isAuthenticated() && (request.auth.token.clubId == clubId || isGlobalAdmin());
      }
    }

    match /teams/{teamId} {
      match /attendance_sessions/{sessionId} {
        allow read, write: if isAuthenticated();
      }
      allow read: if isGlobalAdmin() || (isAuthenticated() && isCleared() && (
        (request.auth.token.clubId != null && (resource == null || resource.data.clubId == request.auth.token.clubId)) ||
        (request.auth.token.email != null && resource != null && (
          resource.data.coachEmail == request.auth.token.email ||
          ('coachEmails' in resource.data && resource.data.coachEmails.hasAny([request.auth.token.email])) ||
          ('assistants' in resource.data && resource.data.assistants.hasAny([request.auth.token.email]))
        )) ||
        (resource != null && (resource.data.coachId == request.auth.uid || resource.data.coachEmail == request.auth.token.email)) ||
        coachStaffCanAccessTeam(teamId)
      ));
      allow create: if isGlobalAdmin() || (isAuthenticated() && isCleared() && (isDirector() || isCoach()) && (request.auth.token.clubId == null || request.resource.data.clubId == request.auth.token.clubId));
      allow update: if isGlobalAdmin() || (isAuthenticated() && isCleared() && (isDirector() || isCoach()) && (request.auth.token.clubId == null || resource.data.clubId == request.auth.token.clubId || resource.data.coachEmail == request.auth.token.email || resource.data.coachId == request.auth.uid) && (!('clubId' in request.resource.data) || request.auth.token.clubId == null || request.resource.data.clubId == request.auth.token.clubId));
      allow delete: if isGlobalAdmin() || (isAuthenticated() && isCleared() && (isDirector() || isCoach()) && (request.auth.token.clubId == null || resource.data.clubId == request.auth.token.clubId));

      match /telemetry_events/{eventId} {
        allow read, write: if coachStaffCanAccessTeam(teamId) || directorScopedToTeam(teamId);
      }

      match /scouting_assessments/{playerKey} {
        allow read, write: if coachStaffCanAccessTeam(teamId) || directorScopedToTeam(teamId);
      }

      match /drills/{drillId} {
        allow read, write: if coachStaffCanAccessTeam(teamId) || directorScopedToTeam(teamId) || isGlobalAdmin();
      }

      match /tactics/{tacticId} {
        allow read, write: if coachStaffCanAccessTeam(teamId) || directorScopedToTeam(teamId) || isGlobalAdmin();
      }

      match /intents/{intentId} {
        allow read, write: if coachStaffCanAccessTeam(teamId) || directorScopedToTeam(teamId) || isGlobalAdmin();
      }
    }

    function isCommissioner() {
      return isAuthenticated() && request.auth.token.role == 'commissioner';
    }

    match /rosters/{teamId} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && isCleared());
      allow write: if isGlobalAdmin() || (isAuthenticated() &&  !isCommissioner());
    }

    match /direct_messages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && !isCommissioner();
    }

    match /sports_configs/{sportId} {
      allow read: if isAuthenticated();
    }




    match /config/{configId} {
      allow read: if isAuthenticated();
    }
    match /platform_settings/{settingId} {
      allow read: if isAuthenticated();
    }
    match /feature_flags/{flagId} {
      allow read: if isAuthenticated();
    }
    match /branding/{brandId} {
      allow read: if isAuthenticated();
    }
    match /license_entitlements/{licenseId} {
      allow read: if isAuthenticated();
    }

    match /team_workouts/{workoutId} {
      allow read: if isAuthenticated();
      allow write: if isCoach() || isDirector();

      match /rsvps/{playerEmail} {
        allow read: if teamWorkoutRsvpReadOk();
        allow write: if isAuthenticated();
      }
    }

    match /scouting_assessments/{playerKey} {
      allow read, write: if isCoach() || isDirector();
    }

    // ✅ Enforced tenant and team isolation for team assignments to prevent cross-tenant leaks
    match /team_assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isGlobalAdmin() ||
        isCoach() ||
        isDirector() ||
        request.auth.token.clubId == null ||
        resource == null ||
        resource.data.clubId == request.auth.token.clubId ||
        resource.data.tenantId == request.auth.token.clubId ||
        (request.auth.token.teamId != null && resource.data.teamId == request.auth.token.teamId)
      );
      allow write: if isGlobalAdmin() || ((isDirector() || isCoach()) && (
        request.auth.token.clubId == null ||
        request.resource.data.clubId == request.auth.token.clubId ||
        request.resource.data.tenantId == request.auth.token.clubId
      ));
    }

    // Helper: Verify requesting user is a Parent, Coach, or Director
    function canAccessDirectory() {
      return request.auth != null &&
        (request.auth.token.role == "parent" ||
         request.auth.token.role == "coach" ||
         request.auth.token.role == "director");
    }

    // Helper: Grab user's sport context for strict containment matching
    function getUserSport(email) {
      return get(/databases/$(database)/documents/users/$(email)).data.sport;
    }

    // Enforce role and tenant check on users collection
    match /organizations/{tenantId} {
      allow read, list: if isGlobalAdmin() || (isAuthenticated() && (
        request.auth.token.tenantId == tenantId || request.auth.token.clubId == tenantId
      ));
    }

    match /users/{emailOrUid} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && (
        isOwner(emailOrUid) ||
        (request.auth.token.clubId != null && resource.data.clubId == request.auth.token.clubId) ||
        (request.auth.token.tenantId != null && resource.data.tenantId == request.auth.token.tenantId)
      ));

      allow write: if isGlobalAdmin() || (isAuthenticated() && isOwner(emailOrUid) &&
        !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['role', 'isCleared', 'isAdult', 'isMinor'])
      );

      // Passkeys subcollection (written by Admin SDK, read by client to check enrollment)
      match /passkeys/{passkeyId} {
        allow read: if isAuthenticated() && (request.auth.uid == emailOrUid || request.auth.token.email == emailOrUid);
      }
    }

    match /recruiters/{document=**} {
      allow read, write: if isGlobalAdmin();
    }

    match /vpc_requests/{requestId} {
      allow read, write: if isAuthenticated() && (isGlobalAdmin());
    }

    // Auth-flow lookup collections — read/write for authenticated staff during roster management
    match /coach_lookup/{email} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin() || (isAuthenticated() && !isCommissioner());
    }
    match /player_lookup/{email} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin() || (isAuthenticated() && !isCommissioner());
    }
    match /registrar_lookup/{email} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin() || (isAuthenticated() && !isCommissioner());
    }
    match /households/{householdId} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin() || (isAuthenticated() && !isCommissioner());
    }

    // Workout logs, physio reports, and training data — authenticated users
    match /workout_logs/{logId} {
      allow read: if isAuthenticated() && (isGlobalAdmin() || isDirector() || isCoach() || resource == null || (('playerId' in resource.data) && resource.data.playerId == request.auth.uid) || (('playerUid' in resource.data) && resource.data.playerUid == request.auth.uid));
      allow create: if isAuthenticated() && ((('playerId' in request.resource.data) && request.resource.data.playerId == request.auth.uid) || (('playerUid' in request.resource.data) && request.resource.data.playerUid == request.auth.uid) || isGlobalAdmin() || isDirector() || isCoach());
      allow update: if isAuthenticated() && ((('playerId' in resource.data) && resource.data.playerId == request.auth.uid) || (('playerUid' in resource.data) && resource.data.playerUid == request.auth.uid) || isGlobalAdmin() || isDirector() || isCoach()) && (!('playerId' in request.resource.data) || request.resource.data.playerId == request.auth.uid || isGlobalAdmin() || isDirector() || isCoach()) && (!('playerUid' in request.resource.data) || request.resource.data.playerUid == request.auth.uid || isGlobalAdmin() || isDirector() || isCoach());
      allow delete: if isAuthenticated() && ((('playerId' in resource.data) && resource.data.playerId == request.auth.uid) || (('playerUid' in resource.data) && resource.data.playerUid == request.auth.uid) || isGlobalAdmin() || isDirector() || isCoach());
    }
    match /grit_awards/{awardId} {
      allow read: if isAuthenticated();
    }

    // Gamification and XP collections
    match /bounties/{bountyId} {
      allow read: if isAuthenticated();
    }
    match /devices/{deviceId} {
      allow read, write: if isAuthenticated();
    }
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
    }

    match /deployment_calendar_entries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if authed();
      allow update, delete: if isDirector();
    }

    match /field_weather_status/{facilityId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /tryout_programs/{programId} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId != null && (resource == null || resource.data.clubId == request.auth.token.clubId));
      allow create: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && request.resource.data.clubId == request.auth.token.clubId);
      allow update: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && resource.data.clubId == request.auth.token.clubId && (!('clubId' in request.resource.data) || request.resource.data.clubId == request.auth.token.clubId));
      allow delete: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && resource.data.clubId == request.auth.token.clubId);

      match /registrations/{registrationId} {
        allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId != null && (resource == null || resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow create: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (request.resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow update: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId) && (!('clubId' in request.resource.data) || request.resource.data.clubId == request.auth.token.clubId));
        allow delete: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
      }
      match /sessions/{sessionId} {
        allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId != null && (resource == null || resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow create: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (request.resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow update: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId) && (!('clubId' in request.resource.data) || request.resource.data.clubId == request.auth.token.clubId));
        allow delete: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
      }
      match /evaluations/{registrationId} {
        allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId != null && (resource == null || resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow create: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (request.resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow update: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId) && (!('clubId' in request.resource.data) || request.resource.data.clubId == request.auth.token.clubId));
        allow delete: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
      }
      match /comms/{commId} {
        allow read: if isGlobalAdmin() || (isAuthenticated() && request.auth.token.clubId != null && (resource == null || resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow create: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (request.resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
        allow update: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId) && (!('clubId' in request.resource.data) || request.resource.data.clubId == request.auth.token.clubId));
        allow delete: if isGlobalAdmin() || ((isDirector() || isCoach()) && request.auth.token.clubId != null && (resource.data.clubId == request.auth.token.clubId || get(/databases/$(database)/documents/tryout_programs/$(programId)).data.clubId == request.auth.token.clubId));
      }
    }

    match /club_playbooks/{playbookId} {
      allow read, write: if isAuthenticated() && resource.data.get('clubId', null) == tokenClub();
    }

    match /consents/{consentId} {
      allow read: if isParent() && resource.data.parentId == emailKey();
      allow create, update, delete: if false;
    }

    match /workouts/{docId} {
      allow read: if isGlobalAdmin() || (isAuthenticated() && (
        resource.data.get('clubId', null) == tokenClub()
      ));
      allow create: if isGlobalAdmin() || (authed() && playerVpcAllowed());
    }

    match /pii_vault/{sealId} {
      allow create, update, delete: if false;
    }

    match /analytics/{document=**} {
      allow read, write: if isGlobalAdmin();
    }
    match /security_audit/{document=**} {
      allow read, write: if isGlobalAdmin();
    }
    match /security_audits/{document=**} {
      allow read, write: if isGlobalAdmin();
    }
    match /message_incidents/{incidentId} {
      allow read: if isDirector() && resource.data.get('clubId', null) == tokenClub();
      allow write: if false; // Callable created only
    }
    match /broadcast_acknowledgements/{ackId} {
      allow read: if isAuthenticated() && (resource.data.parentUid == request.auth.uid || isDirector());
      allow create, update, delete: if false;
    }
    match /sponsor_templates/{templateId} {
      allow read: if isDirector() && resource.data.get('clubId', null) == tokenClub();
      allow create, update, delete: if false;
    }
    match /messaging_audit/{docId} {
      allow read: if isGlobalAdmin() || isDirector();
    }
    match /auditLogs/{document=**} {
      allow read, write: if isGlobalAdmin();
    }
    match /sport_audit_report/{document=**} {
      allow read, write: if isGlobalAdmin();
    }
    match /rl_training_runs/{document=**} {
      allow read, write: if isGlobalAdmin();
    }
    match /rl_safety_overrides/{document=**} {
      allow read, write: if isGlobalAdmin();
    }

    match /team_broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin();
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
         get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.clubId == request.auth.token.get('clubId', null)
      );
      allow write: if isAuthenticated() && coachStaffCanAccessTeam(resource.data.teamId); // Fix client denies
    }

    function canReadParentVoiceSessionDoc(data) {
      return isGlobalAdmin() ||
        (isAuthenticated() && (
          (isDirector() && data.clubId == tokenClub()) ||
          (isCoach() && data.coachEmail == emailKey()) ||
          (isParent() && request.auth.uid in data.participantUids)
        ));
    }

    match /parent_voice_sessions/{sessionId} {
      allow read: if canReadParentVoiceSessionDoc(resource.data);
      allow create, update, delete: if false;
    }

    match /completion_verifications/{verificationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    function canReadParentCoachDmThreadDoc(data) {
      return isGlobalAdmin() ||
        (isAuthenticated() && (
          data.parentEmail == emailKey() ||
          data.coachEmail == emailKey() ||
          (isDirector() && data.clubId == tokenClub())
        ));
    }

    match /parent_coach_threads/{threadId} {
      allow read: if canReadParentCoachDmThreadDoc(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if canReadParentCoachDmThreadDoc(get(/databases/$(database)/documents/parent_coach_threads/$(threadId)).data);
        allow create, update, delete: if false;
      }
    }

    function canReadStaffInternalChannel(ch) {
      return isGlobalAdmin() || (isAuthenticated() && (isDirector() || isCoach() || isRegistrar()));
    }

    function canReadSponsorPartnerChannel(ch) {
      return ch.channelType == 'sponsor_partner' && (resource.data.parentEmail == emailKey() || isDirector() || isGlobalAdmin());
    }

    match /channels/{channelId} {
      allow read: if isAuthenticated() && (
        resource.data.get('channelType', '') != 'staff_internal' || canReadStaffInternalChannel(resource.data)
      );
      allow write: if isGlobalAdmin();

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          (
            resource.data.channelType == 'compliance' &&
            (resource.data.parentEmail == emailKey() || resource.data.householdId == userDoc().householdId || isDirector() || isGlobalAdmin())
          ) ||
          (
            canReadSponsorPartnerChannel(get(/databases/$(database)/documents/channels/$(channelId)).data)
          ) ||
          (
            resource.data.get('channelType', '') != 'staff_internal' || canReadStaffInternalChannel(get(/databases/$(database)/documents/channels/$(channelId)).data)
          )
        );
        allow create, update, delete: if false;
      }
    }

    match /settings/comms {
      // includeAdOnParentDms club comms flag
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin() || isDirector();
    }

    // Default match to prevent global unauthenticated reads/writes

    match /public_drills/{drillId} {
      allow read: if isAuthenticated();
      allow write: if isGlobalAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
